FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install -g pnpm && pnpm install

COPY . .
RUN pnpm run build

FROM node:22-alpine

WORKDIR /app

COPY --from=build /app/.output /app/.output
# COPY --from=build /app/node_modules /app/node_modules # Not always needed with Nuxt 3 output, but sometimes useful. Actually Nuxt 3 standalone output is best.
# However, standard node server often needs just .output/server/index.mjs

ENV PORT=3000
ENV HOST=0.0.0.0
ENV NODE_ENV=production

EXPOSE 3000

# Override the default entrypoint from node:22-alpine
ENTRYPOINT []
CMD ["node", "/app/.output/server/index.mjs"]
