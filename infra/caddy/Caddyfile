# Caddyfile for Procrastinator development environment
# Handles routing to frontend, auth-service, and workspace-service

# Main domain - localhost (HTTP only for development)
http://localhost {
    # Enable logging for debugging
    log {
        level DEBUG
        output file /var/log/caddy/access.log
        format console
    }

    # Health check endpoint for Caddy itself
    handle /health {
        respond "Caddy OK" 200
    }

    # Handle OPTIONS requests for CORS preflight
    @options method OPTIONS
    handle @options {
        respond "" 204
    }

    # Use route to force order of evaluation
    route {
        # Auth service - strip /api/auth prefix and proxy to auth-service:3001
        handle_path /api/auth* {
            reverse_proxy auth-service:3001
        }

        # Workspace service - strip /api/workspaces prefix and proxy to workspace-service:3002
        handle_path /api/workspaces* {
            reverse_proxy workspace-service:3002
        }

        # Task service - strip /api/tasks prefix and proxy to tasks-service:3003
        handle_path /api/tasks* {
            reverse_proxy tasks-service:3003
        }

        # All other requests go to the frontend (Nuxt app)
        handle {
            reverse_proxy task-manager-frontend:3000 {
                # Handle WebSocket connections for HMR
                header_up Connection {>Connection}
                header_up Upgrade {>Upgrade}
            }
        }
    }

    # Enable compression for better performance
    encode gzip

    # CORS headers for development
    header {
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS, PATCH"
        Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
        Access-Control-Allow-Credentials "true"
    }
}

# Admin API configuration
:2019 {
    # Caddy admin interface - accessible at localhost:2019
}
