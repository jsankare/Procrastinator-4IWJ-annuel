{
  "name": "tasks-service",
  "version": "1.0.0",
  "description": "Task Manager - tasks Service",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "docker:ship": "docker build -t procrastinator-tasks-service . && docker tag procrastinator-tasks-service jsankare/procrastinator-tasks-service:latest && docker push jsankare/procrastinator-tasks-service:latest"
  },
  "keywords": [
    "microservice",
    "tasks",
    "collaboration"
  ],
  "private": true,
  "author": "",
  "license": "ISC",
  "devDependencies": {

  },
  "dependencies": {

  }
}
