# Workspace Service Environment Variables

# Server Configuration
NODE_ENV=development
PORT=3002
SERVICE_NAME=workspace-service

# Frontend Configuration
FRONTEND_URL=http://localhost

# Database Configuration
MONGODB_URI=mongodb://procrastinator_user:procrastinator_pass@mongodb:27017/procrastinator?authSource=procrastinator
DB_NAME=procrastinator

# JWT Configuration (should match auth-service)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-please

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
