{
  "name": "workspace-service",
  "version": "1.0.0",
  "description": "Task Manager - Workspace Service",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "docker:ship": "docker build -t procrastinator-workspace-service . && docker tag procrastinator-workspace-service jsankare/procrastinator-workspace-service:latest && docker push jsankare/procrastinator-workspace-service:latest"
  },
  "keywords": [
    "microservice",
    "workspace",
    "collaboration"
  ],
  "private": true,
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^24.5.2",
    "@types/validator": "^13.12.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.8.0",
    "validator": "^13.12.0"
  }
}
